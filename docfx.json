{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "src": "documentation",
        "files": [
          "**/*.{md,yml}"
        ]
      },
      {
        "src": "api",
        "files": [
          "**/*.yml"
        ],
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [
          "documentation/images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "TraceTK",
      "_appTitle": "TraceTK Documentation",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
